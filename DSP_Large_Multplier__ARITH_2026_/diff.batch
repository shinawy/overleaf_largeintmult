+        \caption{The $n\times n$ multiplier is used for the LSB (The adder tree needs a $n+1$-bit adder).}
+        \label{fig:karatsuba_lsb}
+    \end{subfigure}
+    \caption{$n+1$-bit multiplier used in Karatsuba decomposition.}
+    \label{fig:karatsuba_decomposition}
+\end{figure}
 
