    # Extract input slices
    Concat (1'b0, A[16:0]) A_L0_16_0 is_signed=1 op_mode=interleaved
    Concat (1'b0, B[25:0]) B_L0_25_0 is_signed=1 op_mode=interleaved
    Concat (1'b0, A[25:0]) A_L0_25_0 is_signed=1 op_mode=interleaved
    Set (B[43:26]) B_43_26 is_signed=1 op_mode=interleaved
    Set (A[43:26]) A_43_26 is_signed=1 op_mode=interleaved
    Set (B[43:17]) B_43_17 is_signed=1 op_mode=interleaved
    Set (A[43:17]) A_43_17 is_signed=1 op_mode=interleaved
    Concat (1'b0, B[16:0]) B_L0_16_0 is_signed=1 op_mode=interleaved
    Concat (1'b0, A[25:17]) A_L0_25_17 is_signed=1 op_mode=interleaved
    Concat (1'b0, B[25:17]) B_L0_25_17 is_signed=1 op_mode=interleaved

    # Tile multiplications
    Mul (A_L0_16_0, B_L0_25_0) M1_Out_P is_signed=1 op_mode=interleaved
    Mul (A_L0_25_0, B_43_26) M2_Out_P is_signed=1 op_mode=interleaved
