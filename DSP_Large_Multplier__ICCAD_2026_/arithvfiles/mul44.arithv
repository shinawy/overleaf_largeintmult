Prim44x44_Signed(input clk [1], input A [44], input B [44], output P [88]):
    # Variable declarations
    variable A_43_17 [27]
    variable A_43_26 [18]
    variable A_L0_16_0 [18]
    variable A_L0_25_0 [27]
    variable A_L0_25_17 [10]
    variable B_43_17 [27]
