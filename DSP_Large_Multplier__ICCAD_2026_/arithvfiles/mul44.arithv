    Mul (A_L0_25_17, B_L0_25_17) M5_Out_P is_signed=1 op_mode=interleaved

    # Combine all products with shifts
    Shl (M2_Out_P, 26) M2_Out_P is_signed=0 op_mode=interleaved
    Shl (M3_Out_P, 43) M3_Out_P is_signed=0 op_mode=interleaved
