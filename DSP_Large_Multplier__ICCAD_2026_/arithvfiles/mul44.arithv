    Shl (M5_Out_P, 34) M5_Out_P is_signed=0 op_mode=interleaved
    Add (M1_Out_P, M2_Out_P, M3_Out_P, M4_Out_P, M5_Out_P) P is_signed=1 op_mode=lockstep

    TestBench: is_signed=1
